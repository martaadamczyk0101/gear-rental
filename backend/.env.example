# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real secrets.

# Required for the "Ask AI" semantic search feature. Get a key from
# https://console.anthropic.com (Settings -> API Keys). Without this set,
# /hardware/semantic-search responds 503 but the rest of the app works fine.
ANTHROPIC_API_KEY=

# Optional - overrides the model used for semantic search.
ANTHROPIC_SEARCH_MODEL=claude-sonnet-5

# Optional - admin account bootstrapped on first run if one doesn't exist yet.
BOOKSY_ADMIN_EMAIL=admin@booksy.com
BOOKSY_ADMIN_PASSWORD=admin123

# Optional - the frontend origin allowed by CORS.
BOOKSY_FRONTEND_ORIGIN=http://localhost:5173
